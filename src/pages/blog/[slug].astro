---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { extractDescription } from '../../utils/text';
import { isPublished } from '../../utils/publish';
import { relatedPosts } from '../../utils/related';

export async function getStaticPaths() {
  // 前後記事の判定用に古い順で並べる（prev=1つ古い記事、next=1つ新しい記事）
  const posts = (await getCollection('blog'))
    .filter((post) => isPublished(post.data))
    .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: posts[index - 1] ?? null,
      nextPost: posts[index + 1] ?? null,
      related: relatedPosts(post, posts),
    },
  }));
}

const { post, prevPost, nextPost, related } = Astro.props;
const { Content } = await render(post);

const description = extractDescription(post.body ?? '');
---

<BlogPost
  title={post.data.title}
  date={post.data.date}
  categories={post.data.categories}
  description={description}
  prevPost={prevPost}
  nextPost={nextPost}
  related={related}
>
  <Content />
</BlogPost>
