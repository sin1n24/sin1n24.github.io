---
// 記事の「関連商品」セクション。frontmatterのrelatedProducts (ASIN配列) を
// src/data/amazon-products.yml のマスタと突き合わせてカード表示する。
// relatedProducts未指定（または5件未満）の記事は、カテゴリに応じたプールから
// 自動でASINを補完する（新規記事投稿時に手動設定しなくても表示される仕組み）。
import amazonProducts from '../data/amazon-products.yml';
import { resolveRelatedProducts } from '../data/product-pools';

interface Props {
  postId: string;
  categories?: string[];
  explicitAsins?: string[];
}

const { postId, categories, explicitAsins } = Astro.props;
const asins = resolveRelatedProducts(postId, categories, explicitAsins);

const AFFILIATE_TAG = 'sin1n24-22';

const products = asins
  .map((asin) => {
    const entry = (amazonProducts as Record<string, { title: string; image: string }>)[asin];
    if (!entry) return null;
    return {
      asin,
      title: entry.title,
      image: entry.image,
      url: `https://www.amazon.co.jp/dp/${asin}/?tag=${AFFILIATE_TAG}`,
    };
  })
  .filter((p): p is NonNullable<typeof p> => p !== null);
---

{products.length > 0 && (
  <section class="related-products" data-pagefind-ignore>
    <h2 class="section-heading related-products-heading reveal">関連商品</h2>
    <ul class="related-products-grid">
      {products.map((product) => (
        <li>
          <a class="product-card" href={product.url} target="_blank" rel="noopener noreferrer sponsored">
            <img class="product-card-image" src={product.image} alt="" loading="lazy" decoding="async" />
            <span class="product-card-title">{product.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
