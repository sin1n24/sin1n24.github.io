---
// ブログ記事一覧の<ul>部分。blog/index.astro・blog/category/[category].astro で共用。
import type { CollectionEntry } from 'astro:content';
import CategoryTags from './CategoryTags.astro';
import { extractDescription, extractFirstImage } from '../utils/text';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<ul class="blog-list">
  {
    posts.map((post) => {
      const y = post.data.date.getFullYear();
      const m = String(post.data.date.getMonth() + 1).padStart(2, '0');
      const d = String(post.data.date.getDate()).padStart(2, '0');
      const thumb = extractFirstImage(post.body ?? '');
      const excerpt = extractDescription(post.body ?? '', 80);
      return (
        <li class="reveal">
          <div class="blog-list-row">
            {thumb && (
              <img class="post-thumb" src={thumb} alt="" loading="lazy" decoding="async" />
            )}
            <div class="blog-list-content">
              <a href={`/blog/${post.id}/`} class="blog-list-link">
                <p class="post-title">{post.data.title}</p>
              </a>
              <div class="post-meta">
                <p class="post-date">{`${y}年${m}月${d}日`}</p>
                <CategoryTags categories={post.data.categories} />
              </div>
              <p class="card-desc">{excerpt}{excerpt.length >= 80 ? '…' : ''}</p>
            </div>
          </div>
        </li>
      );
    })
  }
</ul>
