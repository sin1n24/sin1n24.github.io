---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import NewsList from '../components/NewsList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CardGrid from '../components/CardGrid.astro';
import news from '../data/news.yml';
import projects from '../../_data/projects.yml';
import protopediaWorks from '../../_data/protopedia_works.yml';
import githubRepos from '../../_data/github_repos.yml';
import { getCollection } from 'astro:content';
import { extractDescription } from '../utils/text';

const latestPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const robotProjects = projects.filter((p: any) => p.category === 'robot');
const hardwareProjects = projects.filter((p: any) => p.category === 'hardware');
const softwareProjects = projects.filter((p: any) => p.category === 'software');
const planningProjects = projects.filter((p: any) => p.category === 'planning');
---

<Base
  description="ロボット・ハードウエア・ソフトウエアをつくる個人工房 sin1's studio のポートフォリオサイト。"
  preloadImage="/img/bg-image.webp"
  hasHero
>
  <Hero />

  <section id="新着情報">
    <div class="container">
      <SectionHeading title="新着情報" lead="ブログ更新やイベント出展、新作公開など、直近の活動をまとめています。" />
      <NewsList items={news} />
    </div>
  </section>

  <section id="ブログ">
    <div class="container">
      <SectionHeading title="ブログ" lead="2007年から続けている製作記録・大会参加報告・技術ノウハウのブログです。全226記事を公開しています。" />
      <ul class="blog-list">
        {latestPosts.map((post) => {
          const y = post.data.date.getFullYear();
          const m = String(post.data.date.getMonth() + 1).padStart(2, '0');
          const d = String(post.data.date.getDate()).padStart(2, '0');
          const excerpt = extractDescription(post.body ?? '', 80);
          return (
            <li class="reveal">
              <a href={`/blog/${post.id}/`} class="blog-list-link">
                <p class="post-title">{post.data.title}</p>
                <p class="post-date">{`${y}年${m}月${d}日`}</p>
                <p class="card-desc">{excerpt}{excerpt.length >= 80 ? '…' : ''}</p>
              </a>
            </li>
          );
        })}
      </ul>
      <p class="reveal"><a class="btn" href="/blog/">ブログ一覧へ</a></p>
    </div>
  </section>

  <section id="ロボット">
    <div class="container">
      <SectionHeading title="ロボット" lead="15年以上出場を続けているかわさきロボット競技大会（かわロボ）を中心に、独自のリンク機構設計やESP-NOWによる無線FPV操縦システムなど、実戦で使うロボットを製作しています。設計・制御基板・遠隔操縦の仕組みまで一貫して自作しているのが特徴です。" />
      <div class="card-grid">
        {robotProjects.map((p: any) => <ProjectCard {...p} />)}
      </div>
    </div>
  </section>

  <section id="ハードウエア">
    <div class="container">
      <SectionHeading title="ハードウエア" lead="M5Stackシリーズ向けの拡張基板を中心に、自分のロボット製作で実際に使うハードウエアを設計・製作しています。スイッチサイエンスで委託販売もしており、まとまった数量でのご相談にも対応しています。" />
      <div class="card-grid">
        {hardwareProjects.map((p: any) => <ProjectCard {...p} />)}
      </div>
    </div>
  </section>

  <section id="ソフトウエア">
    <div class="container">
      <SectionHeading title="ソフトウエア" lead="ロボットの設計を補助するシミュレータから、VR空間での操縦練習ツール、遊べる小さなゲームまで、ものづくりに関わるソフトウエアを幅広く手がけています。C++・Unity・Web技術を用途に応じて使い分けています。" />
      <div class="card-grid">
        {softwareProjects.map((p: any) => <ProjectCard {...p} />)}
      </div>
    </div>
  </section>

  <section id="企画">
    <div class="container">
      <SectionHeading title="企画" lead="「作って戦うロボット文化」を広げるための企画・コミュニティ運営にも取り組んでいます。手のひらサイズの対戦規格「ミニかわロボ」の提唱や、毎年恒例のかわロボ Advent カレンダーなど、技術情報の共有を軸にした活動です。" />
      <div class="card-grid">
        {planningProjects.map((p: any) => <ProjectCard {...p} />)}
      </div>
    </div>
  </section>

  <section id="作品（コンテスト・展示）">
    <div class="container">
      <SectionHeading title="作品（コンテスト・展示）" lead="ProtoPedia 掲載作品 — 自動更新" />
      <CardGrid items={protopediaWorks} compact />
      <p class="reveal"><a class="btn" href="https://protopedia.net/prototyper/sin1" target="_blank" rel="noopener noreferrer">ProtoPediaで全作品を見る</a></p>
    </div>
  </section>

  <section id="Github">
    <div class="container">
      <SectionHeading title="Github" lead="公開リポジトリから自動更新" />
      <CardGrid items={githubRepos} compact />
      <p class="reveal"><a class="btn" href="https://github.com/sin1n24" target="_blank" rel="noopener noreferrer">GitHubで全リポジトリを見る</a></p>
    </div>
  </section>

  <section id="direct-sales">
    <div class="container">
      <SectionHeading title="直販・大量購入について" />
      <p class="reveal">委託品のまとめ買いやカスタム対応など、大量購入・見積りのご相談は Store ページから承っています。</p>
      <p class="reveal"><a class="btn btn-primary" href="/store/">委託品の大量購入・カスタムはこちら</a></p>
    </div>
  </section>

  <section id="お仕事">
    <div class="container">
      <SectionHeading title="お仕事" />
      <p class="reveal">
        本業もあり、現在請け負っている以外の長期契約はできませんが、特定用途に向けた製作品のカスタムや講師など単発での仕事やライセンス販売は実績もあり対応可能ですのでご相談下さいませ。
      </p>
      <p class="reveal"><a class="btn btn-primary" href="mailto:sin1@sin1.studio">お問い合わせ</a></p>
    </div>
  </section>
</Base>
